{
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "cms",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pouta-d1-db",
			"database_id": "a1bfdf11-00d9-4453-ba50-957324fcf7cd"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "pouta-media"
		}
	],
	"ai": {
		"binding": "AI"
	}
}

